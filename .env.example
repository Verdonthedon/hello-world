# ── LeadFlow Pro configuration ───────────────────────────────────────────────
# Copy to `.env` and fill in. The system runs fully in MOCK mode with NO keys.
# Every key is optional; missing keys cause that capability to fall back to mock.

# ── LLM providers (at least one recommended for live runs) ───────────────────
# Anthropic Claude — primary reasoning/copywriting engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini — partner model (analysis + creative variants / QA cross-check)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Which model leads each task: "claude" | "gemini" | "auto"
LLM_ROUTER=auto

# ── Lead discovery ───────────────────────────────────────────────────────────
# Google Places API (New) — primary business discovery source
GOOGLE_PLACES_API_KEY=
# SerpAPI — fallback discovery + SERP/AI-overview checks
SERPAPI_KEY=

# ── Outreach ─────────────────────────────────────────────────────────────────
# Sending is DRAFT-ONLY by default (CAN-SPAM / CASL safe). Never auto-blasts.
# Set to "drafts" (write to Gmail drafts), "queue" (local queue only), or "off".
OUTREACH_MODE=queue
SENDER_NAME=Evan Alexander
SENDER_COMPANY=Sortelle AI
SENDER_EMAIL=
CALENDAR_LINK=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Hard cap on leads processed per run (safety rail)
MAX_LEADS_PER_RUN=25
# Minimum QA score (0-100) required before a deliverable is marked ready
QA_PASS_THRESHOLD=80
OUTPUT_DIR=data/output
