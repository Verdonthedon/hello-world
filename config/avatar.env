# config/avatar.env — runtime configuration for LongCat-Video-Avatar 1.5
#
# Sourced by run_avatar.sh. All values can also be overridden on the
# command line, e.g.  RESOLUTION=480P ./run_avatar.sh
#
# ---------------------------------------------------------------------------

# Location of the cloned LongCat-Video repository (created by setup.sh)
REPO_DIR="LongCat-Video"

# Checkpoint directory for the avatar 1.5 model (relative to REPO_DIR)
CHECKPOINT_DIR="weights/LongCat-Video-Avatar-1.5"

# Number of GPUs to shard across (context parallel size must match nproc).
NUM_GPUS=2

# Input spec describing the driving image + audio + prompt.
# Path is relative to REPO_DIR. See assets/avatar/single_example.json.
INPUT_JSON="assets/avatar/single_example.json"

# Pipeline stage: at2v = audio+text -> video (the standard avatar path).
STAGE_1="at2v"

# Model type — keep as avatar-v1.5 for this setup.
MODEL_TYPE="avatar-v1.5"

# Output resolution: 480P (faster, less VRAM) or 720P (higher quality).
RESOLUTION="720P"

# Audio classifier-free-guidance. 3–5 is the sweet spot; higher = tighter
# lip-sync at the cost of some naturalness.
AUDIO_CFG="4.5"

# Reference-image frame index (0–24). ~10 gives good identity consistency;
# values outside the range reduce repeated/looping actions.
REF_IMG_INDEX="10"

# Mask frame range (default 3). Larger values reduce repeated actions but
# can introduce artifacts if pushed too high.
MASK_FRAME_RANGE="3"

# Reproducibility.
SEED="42"

# Use the distilled (faster) sampler and int8 weights to cut VRAM.
# Set to 0 to disable either.
USE_DISTILL=1
USE_INT8=1
